<section class="sendler-philosophy full-width">
  <div class="sendler-container">

    <div class="sendler-philosophy__intro">

      {% if section.settings.eyebrow != blank %}
        <div class="sendler-eyebrow">
          {{ section.settings.eyebrow }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="sendler-philosophy__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="sendler-philosophy__text">
          {{ section.settings.text }}
        </div>
      {% endif %}

    </div>


    {% if section.blocks.size > 0 %}
      <div class="sendler-philosophy__grid">

        {% for block in section.blocks %}
          <article
            class="sendler-philosophy__item"
            {{ block.shopify_attributes }}
          >

            <div class="sendler-philosophy__icon" aria-hidden="true">

              {% case block.settings.icon %}

                {% when 'evidence' %}
                  <svg viewBox="0 0 32 32">
                    <path d="M5 7.5c4.2 0 7.8 1.2 11 3.6v14.2c-3.2-2.4-6.8-3.6-11-3.6V7.5Z" />
                    <path d="M27 7.5c-4.2 0-7.8 1.2-11 3.6v14.2c3.2-2.4 6.8-3.6 11-3.6V7.5Z" />
                  </svg>

                {% when 'dose' %}
                  <svg viewBox="0 0 32 32">
                    <path d="M9.2 22.8 22.8 9.2a5.1 5.1 0 0 1 7.2 7.2L16.4 30a5.1 5.1 0 0 1-7.2-7.2Z" />
                    <path d="m15.5 16.5 7 7" />
                  </svg>

                {% when 'quality' %}
                  <svg viewBox="0 0 32 32">
                    <circle cx="16" cy="16" r="5" />
                    <path d="M16 3v4M16 25v4M3 16h4M25 16h4M6.8 6.8l2.8 2.8M22.4 22.4l2.8 2.8M25.2 6.8l-2.8 2.8M9.6 22.4l-2.8 2.8" />
                  </svg>

                {% when 'focused' %}
                  <svg viewBox="0 0 32 32">
                    <circle cx="16" cy="10" r="5" />
                    <path d="M6 27c.8-6 4.1-9 10-9s9.2 3 10 9H6Z" />
                  </svg>

              {% endcase %}

            </div>

            {% if block.settings.heading != blank %}
              <h3>{{ block.settings.heading }}</h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <p>{{ block.settings.text }}</p>
            {% endif %}

          </article>
        {% endfor %}

      </div>
    {% endif %}

  </div>
</section>


{% stylesheet %}

.sendler-philosophy {
  padding: 54px 0 48px;
  background: var(--sendler-soft-green);
}

.sendler-philosophy__intro {
  max-width: 760px;
  margin: 0 auto;
  text-align: center;
}

.sendler-philosophy__intro .sendler-eyebrow {
  margin-bottom: 12px;
}

.sendler-philosophy__heading {
  margin: 0;
  font-size: clamp(2rem, 3vw, 2.65rem);
  line-height: 1.05;
  letter-spacing: -0.04em;
}

.sendler-philosophy__text {
  max-width: 720px;
  margin: 14px auto 0;
  font-size: 16px;
  line-height: 1.5;
}

.sendler-philosophy__text p {
  margin: 0;
  color: var(--sendler-charcoal);
}


/* Four principles */

.sendler-philosophy__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 42px;
  margin-top: 34px;
}

.sendler-philosophy__item {
  text-align: center;
}

.sendler-philosophy__icon {
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 13px;
  color: var(--sendler-charcoal);
}

.sendler-philosophy__icon svg {
  width: 32px;
  height: 32px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.6;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.sendler-philosophy__item h3 {
  margin: 0 0 5px;
  font-size: 14px;
  font-weight: 650;
  line-height: 1.3;
  letter-spacing: -0.01em;
}

.sendler-philosophy__item p {
  max-width: 220px;
  margin: 0 auto;
  color: var(--sendler-charcoal);
  font-size: 13px;
  line-height: 1.4;
}


/* Tablet */

@media screen and (max-width: 900px) {

  .sendler-philosophy__grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 36px 40px;
  }

}


/* Mobile */

@media screen and (max-width: 749px) {

  .sendler-philosophy {
    padding: 48px 0;
  }

  .sendler-philosophy__heading {
    font-size: 2rem;
  }

  .sendler-philosophy__text {
    font-size: 15px;
  }

  .sendler-philosophy__grid {
    grid-template-columns: 1fr;
    gap: 30px;
    margin-top: 34px;
  }

}

{% endstylesheet %}


{% schema %}
{
  "name": "SENDLER philosophy",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A SIMPLER APPROACH TO SUPPLEMENTS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Less noise. More of what works."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We cut through the confusion to bring you evidence-backed supplements, sensible doses and clear guidance — so you can feel confident in what you’re taking.</p>"
    }
  ],
  "blocks": [
    {
      "type": "principle",
      "name": "Principle",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "evidence",
              "label": "Evidence"
            },
            {
              "value": "dose",
              "label": "Dose"
            },
            {
              "value": "quality",
              "label": "Quality"
            },
            {
              "value": "focused",
              "label": "Focused"
            }
          ],
          "default": "evidence"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Evidence-led selection"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "We look at the research before we look at the trends."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SENDLER philosophy",
      "blocks": [
        {
          "type": "principle",
          "settings": {
            "icon": "evidence",
            "heading": "Evidence-led selection",
            "text": "We look at the research before we look at the trends."
          }
        },
        {
          "type": "principle",
          "settings": {
            "icon": "dose",
            "heading": "Transparent dosing",
            "text": "We tell you what’s in the product and how much."
          }
        },
        {
          "type": "principle",
          "settings": {
            "icon": "quality",
            "heading": "Quality-first sourcing",
            "text": "Products are selected with manufacturing quality in mind."
          }
        },
        {
          "type": "principle",
          "settings": {
            "icon": "focused",
            "heading": "Focused catalogue",
            "text": "We don’t need hundreds of products to help you make better choices."
          }
        }
      ]
    }
  ]
}
{% endschema %}