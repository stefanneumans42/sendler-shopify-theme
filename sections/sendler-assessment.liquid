<section class="sendler-assessment full-width">
  <div class="sendler-container">

    <div class="sendler-assessment__shell">

      <div class="sendler-assessment__media">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              class: 'sendler-assessment__image',
              widths: '480, 720, 960, 1200',
              sizes: '(min-width: 900px) 50vw, 100vw',
              loading: 'lazy'
          }}
        {% else %}
          <div class="sendler-assessment__placeholder">
            <span>Real life.</span>
            <small>Not wellness theater.</small>
          </div>
        {% endif %}
      </div>

      <div class="sendler-assessment__content">

        {% if section.settings.eyebrow != blank %}
          <div class="sendler-assessment__eyebrow">
            {{ section.settings.eyebrow }}
          </div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="sendler-assessment__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="sendler-assessment__text">
            {{ section.settings.text }}
          </div>
        {% endif %}

        {% if section.settings.trust_text != blank %}
          <div class="sendler-assessment__trust">
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M5 12.5 9.2 17 19 7" />
            </svg>

            <span>{{ section.settings.trust_text }}</span>
          </div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <div class="sendler-assessment__action">

            {% if section.settings.button_link != blank %}
              <a
                href="{{ section.settings.button_link }}"
                class="sendler-assessment__button"
              >
                {{ section.settings.button_label }}

                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M5 12h14M14 7l5 5-5 5" />
                </svg>
              </a>
            {% else %}
              <span class="sendler-assessment__button">
                {{ section.settings.button_label }}

                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M5 12h14M14 7l5 5-5 5" />
                </svg>
              </span>
            {% endif %}

          </div>
        {% endif %}

        {% if section.settings.microcopy != blank %}
          <p class="sendler-assessment__microcopy">
            {{ section.settings.microcopy }}
          </p>
        {% endif %}

      </div>

    </div>

  </div>
</section>


{% stylesheet %}

.sendler-assessment {
  padding: 110px 0;
  background: var(--sendler-canvas);
}

.sendler-assessment__shell {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  min-height: 590px;
  overflow: hidden;
  border-radius: 12px;
}


/* Image */

.sendler-assessment__media {
  min-width: 0;
  background: var(--sendler-soft-green);
}

.sendler-assessment__image {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 590px;
  object-fit: cover;
}

.sendler-assessment__placeholder {
  min-height: 590px;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background:
    linear-gradient(
      135deg,
      rgba(23, 63, 48, 0.04),
      rgba(23, 63, 48, 0.15)
    ),
    var(--sendler-soft-green);
  color: var(--sendler-green);
}

.sendler-assessment__placeholder span {
  font-size: 28px;
  font-weight: 700;
  letter-spacing: -0.03em;
}

.sendler-assessment__placeholder small {
  margin-top: 8px;
  color: var(--sendler-text-secondary);
  font-size: 14px;
}


/* Content */

.sendler-assessment__content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: clamp(56px, 6vw, 90px);
  background: var(--sendler-green);
  color: var(--sendler-white);
}

.sendler-assessment__eyebrow {
  margin-bottom: 18px;
  color: rgba(255, 255, 255, 0.72);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.12em;
  line-height: 1.3;
  text-transform: uppercase;
}

.sendler-assessment__heading {
  max-width: 560px;
  margin: 0;
  color: var(--sendler-white);
  font-size: clamp(2.5rem, 4vw, 3.75rem);
  line-height: 1;
  letter-spacing: -0.045em;
}

.sendler-assessment__text {
  max-width: 550px;
  margin-top: 26px;
  font-size: 17px;
  line-height: 1.6;
}

.sendler-assessment__text p {
  margin: 0;
  color: rgba(255, 255, 255, 0.82);
}

.sendler-assessment__trust {
  display: flex;
  align-items: flex-start;
  gap: 11px;
  margin-top: 28px;
  color: rgba(255, 255, 255, 0.88);
  font-size: 14px;
  line-height: 1.5;
}

.sendler-assessment__trust svg {
  flex: 0 0 20px;
  width: 20px;
  height: 20px;
  margin-top: 1px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.sendler-assessment__action {
  margin-top: 34px;
}

.sendler-assessment__button {
  display: inline-flex;
  min-height: 52px;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 13px 24px;
  border-radius: var(--sendler-radius);
  background: var(--sendler-white);
  color: var(--sendler-green);
  font-size: 15px;
  font-weight: 650;
  line-height: 1;
  text-decoration: none;
  transition:
    transform 160ms ease,
    background-color 160ms ease;
}

.sendler-assessment__button:hover {
  background: var(--sendler-canvas);
  transform: translateY(-1px);
}

.sendler-assessment__button svg {
  width: 18px;
  height: 18px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.sendler-assessment__microcopy {
  margin: 13px 0 0;
  color: rgba(255, 255, 255, 0.62);
  font-size: 12px;
  line-height: 1.4;
}


/* Responsive */

@media screen and (max-width: 900px) {

  .sendler-assessment__shell {
    grid-template-columns: 1fr;
  }

  .sendler-assessment__image,
  .sendler-assessment__placeholder {
    min-height: 460px;
  }

  .sendler-assessment__content {
    padding: 64px;
  }

}

@media screen and (max-width: 749px) {

  .sendler-assessment {
    padding: 80px 0;
  }

  .sendler-assessment__shell {
    border-radius: 8px;
  }

  .sendler-assessment__image,
  .sendler-assessment__placeholder {
    min-height: 340px;
  }

  .sendler-assessment__content {
    padding: 44px 28px;
  }

  .sendler-assessment__heading {
    font-size: 2.5rem;
  }

  .sendler-assessment__button {
    width: 100%;
  }

}

{% endstylesheet %}


{% schema %}
{
  "name": "SENDLER assessment CTA",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lifestyle image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "PERSONALIZED, NOT OVERWHELMING"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What should you actually be taking?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Tell us a little about your diet, lifestyle and goals. We’ll help you narrow down which supplements may make sense for you — and which ones you can probably skip.</p>"
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "Trust message",
      "default": "You don’t need to buy anything from us. The goal is to help you understand what may actually be worth considering."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Take the 2-minute assessment"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "microcopy",
      "label": "Microcopy",
      "default": "Free · No sign-up required · Results shown immediately"
    }
  ],
  "presets": [
    {
      "name": "SENDLER assessment CTA"
    }
  ]
}
{% endschema %}