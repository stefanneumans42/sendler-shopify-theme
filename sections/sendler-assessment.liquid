  margin: 0;
  font-size: 18px;
  letter-spacing: -.025em;
}

.sendler-result-card p {
  margin: 10px 0 0;
  color: var(--sendler-text-secondary);
  font-size: 11px;
  line-height: 1.55;
}

.sendler-result-group.is-unnecessary
.sendler-result-card__status {
  color: var(--sendler-text-secondary);
}

.sendler-result-group.is-context
.sendler-result-card__status {
  color: #7a5b15;
}

.sendler-result-group.is-covered
.sendler-result-card__status {
  color: #547064;
}


/* =========================================================
   RESULTS END
========================================================= */

.sendler-assessment-results__footer {
  max-width: 1000px;
  margin: 48px auto 0;
  padding: 44px;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 50px;
  align-items: center;
  border-radius: 9px;
  background: var(--sendler-green);
  color: var(--sendler-white);
}

.sendler-assessment-results__footer h2 {
  margin: 0;
  max-width: 530px;
  font-size: clamp(2rem, 3vw, 3.4rem);
  line-height: 1;
  letter-spacing: -.045em;
}

.sendler-assessment-results__footer p {
  max-width: 590px;
  margin: 14px 0 0;
  color: rgba(255,255,255,.72);
  font-size: 11px;
  line-height: 1.6;
}

.sendler-assessment-results__actions {
  display: flex;
  flex-direction: column;
  gap: 9px;
  min-width: 190px;
}

.sendler-assessment-results__actions
.sendler-assessment__primary {
  margin: 0;
  background: var(--sendler-white);
  color: var(--sendler-green);
}

.sendler-assessment__secondary {
  min-height: 45px;
  padding: 0 18px;
  border: 1px solid rgba(255,255,255,.35);
  border-radius: 7px;
  background: transparent;
  color: var(--sendler-white);
  font: inherit;
  font-size: 11px;
  font-weight: 650;
  cursor: pointer;
}

.sendler-assessment-results__legal {
  max-width: 900px;
  margin: 32px auto 0;
  color: var(--sendler-text-secondary);
  font-size: 10px;
  line-height: 1.6;
  text-align: center;
}

.sendler-assessment-results__restricted {
  max-width: 800px;
  margin: 20px auto;
  padding: 45px;
  border: 1px solid var(--sendler-border);
  border-radius: 8px;
  background: var(--sendler-white);
  text-align: center;
}

.sendler-assessment-results__restricted h2 {
  margin: 0;
  font-size: 26px;
}

.sendler-assessment-results__restricted p {
  max-width: 600px;
  margin: 15px auto 0;
  color: var(--sendler-text-secondary);
  font-size: 12px;
  line-height: 1.6;
}


/* =========================================================
   MOBILE
========================================================= */

@media screen and (max-width: 749px) {

  .sendler-assessment__intro {
    padding: 65px 0 80px;
  }

  .sendler-assessment__intro h1,
  .sendler-assessment-results__hero h1 {
    font-size: 3.2rem;
  }

  .sendler-assessment__lead {
    font-size: 14px;
  }

  .sendler-assessment__intro-points {
    grid-template-columns: 1fr;
    margin-top: 32px;
  }

  .sendler-assessment__topbar {
    padding-top: 25px;
  }

  .sendler-assessment__question-wrap {
    min-height: 570px;
    padding: 48px 0 80px;
  }

  .sendler-assessment__question-wrap h2 {
    font-size: 2.55rem;
  }

  .sendler-assessment__options {
    grid-template-columns: 1fr;
    gap: 8px;
    margin-top: 27px;
  }

  .sendler-assessment-option {
    min-height: 61px;
  }

  .sendler-assessment-results {
    padding: 65px 0 80px;
  }

  .sendler-assessment-results__hero {
    margin-bottom: 38px;
  }

  .sendler-result-group__header {
    gap: 15px;
  }

  .sendler-result-group__items {
    grid-template-columns: 1fr;
  }

  .sendler-assessment-results__footer {
    grid-template-columns: 1fr;
    gap: 28px;
    padding: 30px 24px;
  }

  .sendler-assessment-results__actions {
    width: 100%;
  }

  .sendler-assessment-results__actions
  .sendler-assessment__primary {
    width: 100%;
  }

}

