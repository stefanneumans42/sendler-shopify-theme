{% assign has_content = false %}

{% if product.metafields.custom.why_exists != blank
  or product.metafields.custom.evidence_summary != blank
  or product.metafields.custom.dose_explanation != blank
  or product.metafields.custom.who_for != blank
  or product.metafields.custom.who_not_for != blank
  or product.metafields.custom.how_to_take != blank
%}
  {% assign has_content = true %}
{% endif %}


<section
  id="sendler-product-information"
  class="sendler-product-overview full-width"
>
  <div class="sendler-container">

    <!-- SECTION NAVIGATION -->
    <nav
      class="sendler-product-overview__nav"
      aria-label="Product information"
    >
      <a href="#sendler-product-information">
        Overview
      </a>

      <a href="#sendler-evidence">
        Evidence
      </a>

      <a href="#sendler-dose">
        Dosage
      </a>

      <a href="#sendler-who-for">
        Who it’s for
      </a>

      <a href="#sendler-how-to-take">
        How to take
      </a>

      <a href="#sendler-ingredients">
        Ingredients
      </a>

      <a href="#sendler-quality">
        Quality
      </a>

      <a href="#sendler-faq">
        FAQ
      </a>
    </nav>


    {% if has_content %}

      <div class="sendler-product-overview__grid">

        <!-- WHY THIS PRODUCT EXISTS -->
        {% if product.metafields.custom.why_exists != blank %}
          <article class="sendler-product-info-card">

            <div class="sendler-product-info-card__icon">
              <svg viewBox="0 0 32 32">
                <path d="M27 6C15 6 8 12 8 21c0 2 .4 4 1.4 5.5"/>
                <path d="M27 6c0 12-5 19-14 19-1.4 0-2.7-.2-3.6-.6"/>
                <path d="M6 28c4-8 9-13 16-17"/>
              </svg>
            </div>

            <div>
              <h2>
                Why this product exists
              </h2>

              <div class="sendler-product-info-card__copy">
                {{ product.metafields.custom.why_exists | metafield_tag }}
              </div>
            </div>

          </article>
        {% endif %}


        <!-- EVIDENCE -->
        {% if product.metafields.custom.evidence_summary != blank %}
          <article
            id="sendler-evidence"
            class="sendler-product-info-card"
          >

            <div class="sendler-product-info-card__icon">
              <svg viewBox="0 0 32 32">
                <path d="M6 26V16h5v10"/>
                <path d="M14 26V10h5v16"/>
                <path d="M22 26V5h5v21"/>
                <path d="M4 27h25"/>
              </svg>
            </div>

            <div>
              <h2>
                What the evidence says
              </h2>

              <div class="sendler-product-info-card__copy">
                {{ product.metafields.custom.evidence_summary | metafield_tag }}
              </div>

              {% if product.metafields.custom.evidence_link != blank %}
                <a
                  href="{{ product.metafields.custom.evidence_link.value }}"
                  class="sendler-product-info-card__link"
                  target="_blank"
                  rel="noopener"
                >
                  Read the science →
                </a>
              {% endif %}
            </div>

          </article>
        {% endif %}


        <!-- DOSE -->
        {% if product.metafields.custom.dose_explanation != blank %}
          <article
            id="sendler-dose"
            class="sendler-product-info-card"
          >

            <div class="sendler-product-info-card__icon">
              <svg viewBox="0 0 32 32">
                <path d="M9.2 22.8 22.8 9.2a5.1 5.1 0 0 1 7.2 7.2L16.4 30a5.1 5.1 0 0 1-7.2-7.2Z"/>
                <path d="m15.5 16.5 7 7"/>
              </svg>
            </div>

            <div>
              <h2>
                Dose matters
              </h2>

              <div class="sendler-product-info-card__copy">
                {{ product.metafields.custom.dose_explanation | metafield_tag }}
              </div>
            </div>

          </article>
        {% endif %}


        <!-- WHO MIGHT CONSIDER -->
        {% if product.metafields.custom.who_for != blank %}
          <article
            id="sendler-who-for"
            class="sendler-product-info-card"
          >

            <div class="sendler-product-info-card__icon">
              <svg viewBox="0 0 32 32">
                <circle cx="16" cy="10" r="5"/>
                <path d="M7 28c0-6 3.6-10 9-10s9 4 9 10"/>
              </svg>
            </div>

            <div>
              <h2>
                Who might consider it
              </h2>

              <div class="sendler-product-info-card__copy sendler-product-info-card__list">
                {{ product.metafields.custom.who_for | metafield_tag }}
              </div>
            </div>

          </article>
        {% endif %}


        <!-- WHO PROBABLY DOESN'T NEED -->
        {% if product.metafields.custom.who_not_for != blank %}
          <article class="sendler-product-info-card">

            <div class="sendler-product-info-card__icon">
              <svg viewBox="0 0 32 32">
                <circle cx="16" cy="16" r="11"/>
                <path d="M8 24 24 8"/>
              </svg>
            </div>

            <div>
              <h2>
                Who probably doesn’t need it
              </h2>

              <div class="sendler-product-info-card__copy sendler-product-info-card__list">
                {{ product.metafields.custom.who_not_for | metafield_tag }}
              </div>
            </div>

          </article>
        {% endif %}


        <!-- HOW TO TAKE -->
        {% if product.metafields.custom.how_to_take != blank %}
          <article
            id="sendler-how-to-take"
            class="sendler-product-info-card"
          >

            <div class="sendler-product-info-card__icon">
              <svg viewBox="0 0 32 32">
                <path d="M9 6h14l-2 22H11L9 6Z"/>
                <path d="M8 11h16"/>
                <path d="M13 3h6"/>
              </svg>
            </div>

            <div>
              <h2>
                How to take it
              </h2>

              <div class="sendler-product-info-card__copy">
                {{ product.metafields.custom.how_to_take | metafield_tag }}
              </div>

              {% if product.metafields.custom.how_to_take_tip != blank %}
                <div class="sendler-product-info-card__tip">
                  <strong>Tip:</strong>
                  {{ product.metafields.custom.how_to_take_tip.value }}
                </div>
              {% endif %}
            </div>

          </article>
        {% endif %}

      </div>


    {% else %}

      <!-- TEMPORARY DEVELOPMENT STATE -->
      <div class="sendler-product-overview__development">

        <h2>
          Product information
        </h2>

        <p>
          This product has not been populated with SENDLER product information yet.
          Evidence, dosage, suitability and usage information will appear here.
        </p>

      </div>

    {% endif %}

  </div>
</section>


{% stylesheet %}

.sendler-product-overview {
  padding: 0 0 68px;
  background: var(--sendler-canvas);
}


/* NAVIGATION */

.sendler-product-overview__nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(22px, 3vw, 48px);
  overflow-x: auto;
  padding: 19px 0;
  border-top: 1px solid var(--sendler-border);
  border-bottom: 1px solid var(--sendler-border);
  scrollbar-width: none;
}

.sendler-product-overview__nav::-webkit-scrollbar {
  display: none;
}

.sendler-product-overview__nav a {
  flex: 0 0 auto;
  color: var(--sendler-charcoal);
  font-size: 12px;
  font-weight: 550;
  text-decoration: none;
}

.sendler-product-overview__nav a:first-child {
  color: var(--sendler-green);
  font-weight: 700;
}


/* GRID */

.sendler-product-overview__grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
  margin-top: 28px;
}


/* INFO CARDS */

.sendler-product-info-card {
  display: grid;
  grid-template-columns: 36px 1fr;
  gap: 15px;
  align-content: start;
  min-height: 245px;
  padding: 27px 24px;
  border: 1px solid var(--sendler-border);
  border-radius: 9px;
  background: var(--sendler-white);
}

.sendler-product-info-card__icon {
  width: 34px;
  height: 34px;
  color: var(--sendler-green);
}

.sendler-product-info-card__icon svg {
  width: 100%;
  height: 100%;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.5;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.sendler-product-info-card h2 {
  margin: 3px 0 0;
  color: var(--sendler-charcoal);
  font-size: 17px;
  line-height: 1.25;
  letter-spacing: -0.025em;
}

.sendler-product-info-card__copy {
  margin-top: 14px;
  color: var(--sendler-text-secondary);
  font-size: 13px;
  line-height: 1.6;
}

.sendler-product-info-card__copy p {
  margin: 0 0 10px;
}

.sendler-product-info-card__copy p:last-child {
  margin-bottom: 0;
}

.sendler-product-info-card__copy ul {
  margin: 0;
  padding-left: 17px;
}

.sendler-product-info-card__copy li {
  margin-top: 6px;
}

.sendler-product-info-card__copy li::marker {
  color: var(--sendler-green);
}

.sendler-product-info-card__link {
  display: inline-block;
  margin-top: 15px;
  color: var(--sendler-green);
  font-size: 12px;
  font-weight: 700;
  text-decoration: underline;
  text-underline-offset: 3px;
}


/* TIP */

.sendler-product-info-card__tip {
  margin-top: 16px;
  padding: 12px 13px;
  border-radius: 6px;
  background: var(--sendler-soft-green);
  color: var(--sendler-charcoal);
  font-size: 12px;
  line-height: 1.5;
}


/* DEVELOPMENT PLACEHOLDER */

.sendler-product-overview__development {
  max-width: 700px;
  margin: 32px auto 0;
  padding: 35px;
  border: 1px dashed var(--sendler-border);
  border-radius: 8px;
  text-align: center;
}

.sendler-product-overview__development h2 {
  margin: 0;
  font-size: 22px;
}

.sendler-product-overview__development p {
  max-width: 520px;
  margin: 10px auto 0;
  color: var(--sendler-text-secondary);
  font-size: 13px;
  line-height: 1.55;
}


/* TABLET */

@media screen and (max-width: 1000px) {

  .sendler-product-overview__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

}


/* MOBILE */

@media screen and (max-width: 749px) {

  .sendler-product-overview {
    padding-bottom: 46px;
  }

  .sendler-product-overview__nav {
    justify-content: flex-start;
    margin-right: -20px;
    margin-left: -20px;
    padding-right: 20px;
    padding-left: 20px;
  }

  .sendler-product-overview__grid {
    grid-template-columns: 1fr;
    gap: 10px;
    margin-top: 20px;
  }

  .sendler-product-info-card {
    min-height: 0;
    padding: 23px 20px;
  }

}

{% endstylesheet %}


{% schema %}
{
  "name": "SENDLER Product overview",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "SENDLER Product overview"
    }
  ]
}
{% endschema %}