<section class="sendler-why-standard full-width">
  <div class="sendler-container">

    <div class="sendler-why-standard__header">

      {% if section.settings.eyebrow != blank %}
        <div class="sendler-why-standard__eyebrow">
          {{ section.settings.eyebrow }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="sendler-why-standard__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="sendler-why-standard__intro">
          {{ section.settings.text }}
        </div>
      {% endif %}

    </div>


    {% if section.blocks.size > 0 %}
      <div class="sendler-why-standard__grid">

        {% for block in section.blocks %}
          <article
            class="sendler-why-standard__item"
            {{ block.shopify_attributes }}
          >

            <div class="sendler-why-standard__icon" aria-hidden="true">

              {% case block.settings.icon %}

                {% when 'evidence' %}
                  <svg viewBox="0 0 32 32">
                    <path d="M5 7.5c4.2 0 7.8 1.2 11 3.6v14.2c-3.2-2.4-6.8-3.6-11-3.6V7.5Z" />
                    <path d="M27 7.5c-4.2 0-7.8 1.2-11 3.6v14.2c3.2-2.4 6.8-3.6 11-3.6V7.5Z" />
                  </svg>

                {% when 'dose' %}
                  <svg viewBox="0 0 32 32">
                    <path d="M9.2 22.8 22.8 9.2a5.1 5.1 0 0 1 7.2 7.2L16.4 30a5.1 5.1 0 0 1-7.2-7.2Z" />
                    <path d="m15.5 16.5 7 7" />
                  </svg>

                {% when 'quality' %}
                  <svg viewBox="0 0 32 32">
                    <circle cx="16" cy="16" r="5" />
                    <path d="M16 3v4M16 25v4M3 16h4M25 16h4M6.8 6.8l2.8 2.8M22.4 22.4l2.8 2.8M25.2 6.8l-2.8 2.8M9.6 22.4l-2.8 2.8" />
                  </svg>

                {% when 'usefulness' %}
                  <svg viewBox="0 0 32 32">
                    <path d="M26 6C16 6 8 11.5 8 20c0 2 .5 4 1.6 5.5" />
                    <path d="M26 6c0 10-4.2 17-12 17-1.8 0-3.2-.4-4.4-1.1" />
                    <path d="M7 27c3-6 7-10 13-14" />
                  </svg>

              {% endcase %}

            </div>

            {% if block.settings.heading != blank %}
              <h3>{{ block.settings.heading }}</h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <p>{{ block.settings.text }}</p>
            {% endif %}

          </article>
        {% endfor %}

      </div>
    {% endif %}

  </div>
</section>


{% stylesheet %}

.sendler-why-standard {
  padding: 70px 0 74px;
  background: var(--sendler-green);
  color: var(--sendler-white);
}

.sendler-why-standard__header {
  max-width: 780px;
  margin: 0 auto 44px;
  text-align: center;
}

.sendler-why-standard__eyebrow {
  margin-bottom: 12px;
  color: rgba(255, 255, 255, 0.64);
  font-size: 11px;
  font-weight: 650;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.sendler-why-standard__heading {
  margin: 0;
  color: var(--sendler-white);
  font-size: clamp(2.5rem, 4vw, 3.8rem);
  line-height: 1;
  letter-spacing: -0.045em;
}

.sendler-why-standard__intro {
  max-width: 650px;
  margin: 15px auto 0;
  font-size: 16px;
  line-height: 1.5;
}

.sendler-why-standard__intro p {
  margin: 0;
  color: rgba(255, 255, 255, 0.74);
}


/* Four standards */

.sendler-why-standard__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  max-width: 1100px;
  margin: 0 auto;
}

.sendler-why-standard__item {
  padding: 10px 32px;
  border-right: 1px solid rgba(255, 255, 255, 0.2);
  text-align: center;
}

.sendler-why-standard__item:first-child {
  padding-left: 0;
}

.sendler-why-standard__item:last-child {
  padding-right: 0;
  border-right: 0;
}

.sendler-why-standard__icon {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 17px;
  color: var(--sendler-white);
}

.sendler-why-standard__icon svg {
  width: 34px;
  height: 34px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.5;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.sendler-why-standard__item h3 {
  margin: 0;
  color: var(--sendler-white);
  font-size: 18px;
  line-height: 1.25;
}

.sendler-why-standard__item p {
  max-width: 210px;
  margin: 9px auto 0;
  color: rgba(255, 255, 255, 0.7);
  font-size: 13px;
  line-height: 1.5;
}


@media screen and (max-width: 900px) {

  .sendler-why-standard__grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .sendler-why-standard__item {
    padding: 30px;
  }

  .sendler-why-standard__item:nth-child(2n) {
    border-right: 0;
  }

  .sendler-why-standard__item:nth-child(-n + 2) {
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  }

}


@media screen and (max-width: 749px) {

  .sendler-why-standard {
    padding: 58px 0;
  }

  .sendler-why-standard__header {
    margin-bottom: 30px;
  }

  .sendler-why-standard__heading {
    font-size: 2.35rem;
  }

  .sendler-why-standard__grid {
    grid-template-columns: 1fr;
  }

  .sendler-why-standard__item,
  .sendler-why-standard__item:first-child,
  .sendler-why-standard__item:last-child {
    padding: 26px 0;
    border-right: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
  }

  .sendler-why-standard__item:last-child {
    border-bottom: 0;
  }

}

{% endstylesheet %}


{% schema %}
{
  "name": "SENDLER Why standard",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE SENDLER STANDARD"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every product has to earn its place."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We apply a simple set of non-negotiables to everything we offer.</p>"
    }
  ],
  "blocks": [
    {
      "type": "standard",
      "name": "Standard",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "evidence",
              "label": "Evidence"
            },
            {
              "value": "dose",
              "label": "Dose"
            },
            {
              "value": "quality",
              "label": "Quality"
            },
            {
              "value": "usefulness",
              "label": "Usefulness"
            }
          ],
          "default": "evidence"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SENDLER Why standard",
      "blocks": [
        {
          "type": "standard",
          "settings": {
            "icon": "evidence",
            "heading": "Evidence",
            "text": "Does the research support a meaningful use?"
          }
        },
        {
          "type": "standard",
          "settings": {
            "icon": "dose",
            "heading": "Dose",
            "text": "Is there enough of the ingredient to make sense?"
          }
        },
        {
          "type": "standard",
          "settings": {
            "icon": "quality",
            "heading": "Quality",
            "text": "Can we stand behind how it’s manufactured?"
          }
        },
        {
          "type": "standard",
          "settings": {
            "icon": "usefulness",
            "heading": "Usefulness",
            "text": "Does this solve a real problem?"
          }
        }
      ]
    }
  ]
}
{% endschema %}