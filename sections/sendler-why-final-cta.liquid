<section class="sendler-why-final-cta full-width">
  <div class="sendler-container">

    <div class="sendler-why-final-cta__card">

      <div class="sendler-why-final-cta__content">

        {% if section.settings.eyebrow != blank %}
          <div class="sendler-why-final-cta__eyebrow">
            {{ section.settings.eyebrow }}
          </div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="sendler-why-final-cta__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="sendler-why-final-cta__text">
            {{ section.settings.text }}
          </div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a
            class="sendler-why-final-cta__button"
            href="{{ section.settings.button_link }}"
          >
            {{ section.settings.button_label }}
          </a>
        {% endif %}

        {% if section.settings.microcopy != blank %}
          <div class="sendler-why-final-cta__microcopy">
            {{ section.settings.microcopy }}
          </div>
        {% endif %}

      </div>


      <div class="sendler-why-final-cta__steps">

        <div class="sendler-why-final-cta__step">
          <span>01</span>
          <div>
            <strong>Tell us about yourself</strong>
            <p>A few questions about your diet, lifestyle and goals.</p>
          </div>
        </div>

        <div class="sendler-why-final-cta__step">
          <span>02</span>
          <div>
            <strong>See what may make sense</strong>
            <p>Get a clearer view of supplements that may be worth considering.</p>
          </div>
        </div>

        <div class="sendler-why-final-cta__step">
          <span>03</span>
          <div>
            <strong>Skip what probably doesn’t</strong>
            <p>No pressure to buy. The goal is clarity, not a bigger basket.</p>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>


{% stylesheet %}

.sendler-why-final-cta {
  padding: 72px 0;
  background: var(--sendler-white);
}

.sendler-why-final-cta__card {
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
  gap: clamp(60px, 8vw, 110px);
  align-items: center;
  overflow: hidden;
  padding: clamp(48px, 6vw, 78px);
  border-radius: 14px;
  background: var(--sendler-green);
  color: var(--sendler-white);
}

.sendler-why-final-cta__content {
  max-width: 640px;
}

.sendler-why-final-cta__eyebrow {
  margin-bottom: 14px;
  color: rgba(255, 255, 255, 0.62);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.sendler-why-final-cta__heading {
  margin: 0;
  color: var(--sendler-white);
  font-size: clamp(2.7rem, 4.5vw, 4.4rem);
  line-height: 0.98;
  letter-spacing: -0.05em;
}

.sendler-why-final-cta__text {
  max-width: 570px;
  margin-top: 20px;
  color: rgba(255, 255, 255, 0.74);
  font-size: 16px;
  line-height: 1.6;
}

.sendler-why-final-cta__text p {
  margin: 0;
}

.sendler-why-final-cta__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  margin-top: 28px;
  padding: 0 24px;
  border: 1px solid var(--sendler-white);
  border-radius: 8px;
  background: var(--sendler-white);
  color: var(--sendler-green);
  font-size: 14px;
  font-weight: 700;
  text-decoration: none;
  transition:
    background 0.2s ease,
    color 0.2s ease;
}

.sendler-why-final-cta__button:hover {
  background: transparent;
  color: var(--sendler-white);
}

.sendler-why-final-cta__microcopy {
  margin-top: 11px;
  color: rgba(255, 255, 255, 0.58);
  font-size: 11px;
}


/* Steps */

.sendler-why-final-cta__steps {
  border-top: 1px solid rgba(255, 255, 255, 0.18);
}

.sendler-why-final-cta__step {
  display: grid;
  grid-template-columns: 44px 1fr;
  gap: 18px;
  padding: 25px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.18);
}

.sendler-why-final-cta__step span {
  padding-top: 2px;
  color: rgba(255, 255, 255, 0.48);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.09em;
}

.sendler-why-final-cta__step strong {
  display: block;
  color: var(--sendler-white);
  font-size: 15px;
  line-height: 1.3;
}

.sendler-why-final-cta__step p {
  margin: 6px 0 0;
  color: rgba(255, 255, 255, 0.65);
  font-size: 13px;
  line-height: 1.5;
}


@media screen and (max-width: 900px) {

  .sendler-why-final-cta__card {
    grid-template-columns: 1fr;
    gap: 45px;
  }

}


@media screen and (max-width: 749px) {

  .sendler-why-final-cta {
    padding: 48px 0;
  }

  .sendler-why-final-cta__card {
    gap: 38px;
    padding: 42px 24px;
    border-radius: 10px;
  }

  .sendler-why-final-cta__heading {
    font-size: 2.55rem;
  }

}

{% endstylesheet %}


{% schema %}
{
  "name": "SENDLER Why final CTA",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FIND YOUR ESSENTIALS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Still not sure what makes sense for you?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Take our short assessment and get a simpler view of what may be worth considering — and what you can probably skip.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Find My Essentials"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "microcopy",
      "label": "Microcopy",
      "default": "Free · About 2 minutes · No purchase required"
    }
  ],
  "presets": [
    {
      "name": "SENDLER Why final CTA"
    }
  ]
}
{% endschema %}