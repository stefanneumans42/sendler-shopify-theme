<section class="sendler-product-assessment full-width">
  <div class="sendler-container">

    <div class="sendler-product-assessment__card">

      <div class="sendler-product-assessment__content">

        {% if section.settings.eyebrow != blank %}
          <div class="sendler-product-assessment__eyebrow">
            {{ section.settings.eyebrow }}
          </div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2>
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="sendler-product-assessment__text">
            {{ section.settings.text }}
          </div>
        {% endif %}


        {% if section.settings.button_label != blank %}
          <a
            href="{{ section.settings.button_link }}"
            class="sendler-product-assessment__button"
          >
            {{ section.settings.button_label }}
            <span aria-hidden="true">→</span>
          </a>
        {% endif %}


        {% if section.settings.microcopy != blank %}
          <div class="sendler-product-assessment__microcopy">
            {{ section.settings.microcopy }}
          </div>
        {% endif %}

      </div>


      <div class="sendler-product-assessment__right">

        <div class="sendler-product-assessment__icon" aria-hidden="true">
          <svg viewBox="0 0 48 48">
            <path d="M39 8C23 9 12 18 12 31c0 3 .7 5.8 2 8"/>
            <path d="M39 8c0 17-8 27-21 27-1.7 0-3.2-.2-4.5-.6"/>
            <path d="M8 42c6-12 14-20 25-27"/>
          </svg>
        </div>


        <div class="sendler-product-assessment__point">
          <span>01</span>

          <div>
            <strong>Tell us about yourself</strong>
            <p>Diet, lifestyle and what you’re trying to accomplish.</p>
          </div>
        </div>


        <div class="sendler-product-assessment__point">
          <span>02</span>

          <div>
            <strong>See what may actually make sense</strong>
            <p>Get a clearer starting point instead of another giant supplement list.</p>
          </div>
        </div>


        <div class="sendler-product-assessment__point">
          <span>03</span>

          <div>
            <strong>Skip what probably doesn’t</strong>
            <p>No pressure to buy something simply because SENDLER sells it.</p>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>


{% stylesheet %}

.sendler-product-assessment {
  padding: 0 0 70px;
  background: var(--sendler-white);
}

.sendler-product-assessment__card {
  display: grid;
  grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr);
  gap: clamp(55px, 7vw, 95px);
  align-items: center;
  padding: clamp(46px, 6vw, 72px);
  border-radius: 12px;
  background: var(--sendler-green);
  color: var(--sendler-white);
}

.sendler-product-assessment__content {
  max-width: 610px;
}

.sendler-product-assessment__eyebrow {
  margin-bottom: 13px;
  color: rgba(255,255,255,.62);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .13em;
  text-transform: uppercase;
}

.sendler-product-assessment h2 {
  margin: 0;
  color: var(--sendler-white);
  font-size: clamp(2.6rem, 4vw, 4rem);
  line-height: .98;
  letter-spacing: -.05em;
}

.sendler-product-assessment__text {
  max-width: 555px;
  margin-top: 18px;
  color: rgba(255,255,255,.74);
  font-size: 15px;
  line-height: 1.6;
}

.sendler-product-assessment__text p {
  margin: 0;
}

.sendler-product-assessment__button {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  min-height: 47px;
  margin-top: 25px;
  padding: 0 21px;
  border-radius: 7px;
  background: var(--sendler-white);
  color: var(--sendler-green);
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
}

.sendler-product-assessment__button:hover {
  background: var(--sendler-soft-green);
}

.sendler-product-assessment__microcopy {
  margin-top: 10px;
  color: rgba(255,255,255,.55);
  font-size: 10px;
}


/* RIGHT */

.sendler-product-assessment__right {
  border-top: 1px solid rgba(255,255,255,.18);
}

.sendler-product-assessment__icon {
  width: 48px;
  height: 48px;
  margin: 0 0 4px;
  transform: translateY(-64px);
}

.sendler-product-assessment__icon svg {
  width: 100%;
  height: 100%;
  fill: none;
  stroke: rgba(255,255,255,.82);
  stroke-width: 1.5;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.sendler-product-assessment__point {
  display: grid;
  grid-template-columns: 42px 1fr;
  gap: 14px;
  padding: 21px 0;
  border-bottom: 1px solid rgba(255,255,255,.18);
}

.sendler-product-assessment__point > span {
  padding-top: 2px;
  color: rgba(255,255,255,.44);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .08em;
}

.sendler-product-assessment__point strong {
  display: block;
  color: var(--sendler-white);
  font-size: 14px;
  line-height: 1.3;
}

.sendler-product-assessment__point p {
  margin: 5px 0 0;
  color: rgba(255,255,255,.65);
  font-size: 12px;
  line-height: 1.5;
}


/* TABLET */

@media screen and (max-width: 900px) {

  .sendler-product-assessment__card {
    grid-template-columns: 1fr;
    gap: 45px;
  }

  .sendler-product-assessment__icon {
    transform: none;
    margin-bottom: 14px;
  }

}


/* MOBILE */

@media screen and (max-width: 749px) {

  .sendler-product-assessment {
    padding-bottom: 48px;
  }

  .sendler-product-assessment__card {
    gap: 35px;
    padding: 40px 24px;
  }

  .sendler-product-assessment h2 {
    font-size: 2.5rem;
  }

}

{% endstylesheet %}


{% schema %}
{
  "name": "SENDLER Assessment CTA",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "NOT SURE IT’S FOR YOU?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You probably don’t need everything here."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Take the SENDLER assessment and get a simpler view of what may be worth considering — including products you probably don’t need.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Find My Essentials"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "microcopy",
      "label": "Microcopy",
      "default": "Free · About 2 minutes · No purchase required"
    }
  ],
  "presets": [
    {
      "name": "SENDLER Assessment CTA"
    }
  ]
}
{% endschema %}