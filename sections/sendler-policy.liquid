<article class="sendler-support full-width">
<h1>{{ section.settings.heading | escape }}</h1>
{% for block in section.blocks %}
<section {{ block.shopify_attributes }}>
<h2>{{ block.settings.heading | escape }}</h2>{{ block.settings.content }}</section>
{% endfor %}
</article>
{% stylesheet %}
.sendler-support {
  width: min(800px, calc(100% - 40px));
  margin: 0 auto;
  padding: 64px 0 80px;
}

.sendler-support h1 {
  margin: 0 0 24px;
}

.sendler-support h2 {
  font-size: clamp(24px, 3vw, 30px);
  margin: 40px 0 16px;
}

.sendler-support p {
  line-height: 1.75;
}

.sendler-support a {
  text-decoration: underline;
  text-underline-offset: 3px;
  overflow-wrap: anywhere;
}

.sendler-support :focus-visible {
  outline: 3px solid var(--sendler-green);
  outline-offset: 4px;
}

@media(max-width:749px) {
  .sendler-support {
  padding: 40px 0 56px;
}


}

{% endstylesheet %}
{% schema %}{
  "name": "SENDLER policy",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shipping Policy"
    }
  ],
  "blocks": [
    {
      "type": "paragraph",
      "name": "Policy topic",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    }
  ]
}{% endschema %}
